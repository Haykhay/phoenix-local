# Copy to .env and adjust. .env is gitignored; .env.example is the shared default.

# Pin the Floci image — this pin IS the standard.
# CI evidence (floci-smoke): 2.4.0 fails the Control Tower landing-zone read-back
# ("couldn't find resource"); `nightly` applies org + landing zone + DynamoDB
# cleanly (the PRs #7298/#7403 fixes are in main, not yet in a stable release).
# TODO: re-pin to the first STABLE tag that includes those fixes when published.
FLOCI_VERSION=nightly

FLOCI_PORT=4566
FLOCI_STORAGE_MODE=memory          # memory | persistent | hybrid | wal
AWS_DEFAULT_REGION=eu-west-1
FLOCI_ACCOUNT_ID=000000000000

# Terraform / AWS CLI on the HOST point at Floci with dummy creds:
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
