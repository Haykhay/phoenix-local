# Copy to .env and adjust. .env is gitignored; .env.example is the shared default.

# Pin the Floci image — this pin IS the standard.
# VERIFY the current stable tag at https://hub.docker.com/r/floci/floci/tags
# It MUST include the Control Tower landing-zone fixes (floci PRs #7298, #7403),
# otherwise `aws_controltower_landing_zone` fails to apply.
FLOCI_VERSION=2.4.0

FLOCI_PORT=4566
FLOCI_STORAGE_MODE=memory          # memory | persistent | hybrid | wal
AWS_DEFAULT_REGION=eu-west-1
FLOCI_ACCOUNT_ID=000000000000

# Terraform / AWS CLI on the HOST point at Floci with dummy creds:
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
